---
services:
  - id: discovery
    type: discovery
    address: /services/discovery
    protocol_bindings:
      - urn:taxii.mitre.org:protocol:http:1.0
    authentication_required: false
    description: Discovery service

  - id: collection-management
    type: collection_management
    address: /services/collection-management
    protocol_bindings:
      - urn:taxii.mitre.org:protocol:http:1.0
    authentication_required: true
    description: Collection management service

  - id: poll
    type: poll
    address: /services/poll
    protocol_bindings:
      - urn:taxii.mitre.org:protocol:http:1.0
    authentication_required: true
    description: Poll service

  - id: inbox
    type: inbox
    address: /services/inbox
    protocol_bindings:
      - urn:taxii.mitre.org:protocol:http:1.0
    authentication_required: true
    destination_collection_required: true
    accept_all_content: true
    supported_content:
      - urn:stix.mitre.org:xml:1.2
    description: Inbox service

collections:
  - name: Alerts
    id: alerts
    description: Slips alerts collection
    type: DATA_SET
    available: true
    accept_all_content: true
    supported_content:
      - application/stix+xml;version=1.2
      - application/stix+json;version=1.2
    service_ids:
      - discovery
      - collection-management
      - poll
      - inbox

accounts:
  - username: "{{OPENTAXII_TAXII_USERNAME}}"
    password: "{{OPENTAXII_TAXII_PASSWORD}}"
    is_admin: true
